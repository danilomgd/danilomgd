{
  "name": "@velio/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Apps VÉLIO (cliente) e VÉLIO Pro (prestador) em Expo Router, gerados do mesmo código por EXPO_PUBLIC_APP_ROLE (ADR-010).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:customer": "EXPO_PUBLIC_APP_ROLE=customer expo start",
    "start:provider": "EXPO_PUBLIC_APP_ROLE=provider expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "echo 'builds via EAS: eas build --profile <profile>'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@velio/api-client": "workspace:*",
    "@velio/contracts": "workspace:*",
    "@velio/domain": "workspace:*",
    "@velio/ui": "workspace:*",
    "expo": "~57.0.28",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~57.0.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
