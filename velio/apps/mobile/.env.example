# Qual produto gerar: customer (VÉLIO) ou provider (VÉLIO Pro)
EXPO_PUBLIC_APP_ROLE=customer
# URL base da API (apps/api). No aparelho físico use o IP da máquina, não localhost.
EXPO_PUBLIC_API_URL=http://localhost:3333
# Opcional: chave do Google Maps para Android (react-native-maps). iOS usa Apple Maps.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Opcional: endpoint de upload de mídia (multipart) enquanto a API não oferece URL assinada.
EXPO_PUBLIC_UPLOAD_URL=
# EAS
EAS_PROJECT_ID=
