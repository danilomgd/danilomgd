# ---------------------------------------------------------------
# Credenciais da Higgsfield API - SDK oficial (higgsfield-client)
# ---------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com a sua chave:
#
#     cp .env.local.example .env.local
#
# O SDK oficial le a variavel HF_KEY no formato  key-id:key-secret
# (um unico valor, com dois-pontos separando as duas partes).
#
# Exemplo de formato (valores ficticios):
#     HF_KEY=ak_7f3c9d2e:sk_8b1a4e6f0c2d5a9b3e7f
#
# .env.local esta no .gitignore e nunca e versionado.
# Preencha este arquivo LOCALMENTE, no seu editor.
# Nunca cole a chave em chat, issue, commit ou mensagem.
# ---------------------------------------------------------------

HF_KEY=

# Alternativa: o SDK tambem aceita as duas partes separadas.
# Use uma forma OU a outra, nao as duas.
# HF_API_KEY=
# HF_API_SECRET=
