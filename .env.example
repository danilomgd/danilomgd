# ---------------------------------------------------------------
# Credenciais da Higgsfield API
# ---------------------------------------------------------------
# Gere em: https://cloud.higgsfield.ai  (secao API Keys / Console)
#
# COPIE este arquivo para .env e preencha os valores reais:
#     cp .env.example .env
#
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado,
# colado em chat, ou enviado por mensagem.
# ---------------------------------------------------------------

HF_API_KEY=coloque_aqui_o_key_id
HF_API_SECRET=coloque_aqui_o_key_secret

# Alternativa aceita pelo cliente (formato unico "key:secret").
# Se preenchida, tem prioridade sobre as duas variaveis acima.
# HF_CREDENTIALS=key_id:key_secret

# Opcional - so altere se a Higgsfield indicar outro host
HF_BASE_URL=https://api.higgsfield.ai

# Opcional - URL publica que recebe o callback quando o job termina
# HF_WEBHOOK_URL=https://seu-dominio.com/webhooks/higgsfield
# HF_WEBHOOK_SECRET=uma_string_aleatoria_longa
