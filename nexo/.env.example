# Deixe vazio para usar PGlite (Postgres embutido, arquivo em .data/pglite).
# Preencha para usar Postgres real (ex.: Supabase).
# Supabase: Settings → Database → Connection string → "Transaction pooler" (porta 6543):
# postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Pasta de dados do PGlite (padrão: .data/pglite)
PGLITE_DATA_DIR=
