{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXO — plataforma própria de gestão de trabalho (hierarquia, tarefas, visões, docs, dashboards e metas).",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .data && echo 'banco local apagado; reinicie o dev server'",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.9",
    "@tanstack/react-query": "^5.104.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "@electric-sql/pglite"
    ]
  }
}
