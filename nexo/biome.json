{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["**", "!.next", "!node_modules", "!drizzle", "!.data", "!test-results"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noArrayIndexKey": "off", "noExplicitAny": "warn" },
      "a11y": {
        "noAutofocus": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useButtonType": "off"
      },
      "complexity": { "noForEach": "off" },
      "style": { "noNonNullAssertion": "off" },
      "correctness": { "useExhaustiveDependencies": "warn" }
    }
  }
}
